# Copy this file to .env and fill in the values. .env is gitignored: never commit it.
# Variables already set in the environment (CI, or your shell) win over this file.

# Environment under test: prod (default) or dev. See docs/qa-knowledge/environments.md.
#   prod: the real site, public (read-only) suite only
#   dev:  the app's develop branch on the dev database; public + admin suites
TEST_ENV=

# Optional: override the URL (a specific preview, localhost). TEST_ENV still decides
# which suites exist.
BASE_URL=

# Required for TEST_ENV=dev: lets tests past Vercel's login on the dev URL.
# Vercel -> salon-caporale-v2 -> Settings -> Deployment Protection -> Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Admin suite (dev only, from CAPOQA-8)
ADMIN_EMAIL=
ADMIN_PASSWORD=
