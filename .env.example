# Copy this file to .env and fill in the values. .env is gitignored: never commit it.

# Site under test. Empty = prod (https://salon-caporale-v2-zeta.vercel.app), which is safe
# for the read-only public suite. Dev (safe to write):
# https://salon-caporale-v2-git-develop-pablos-projects-553b98e7.vercel.app
BASE_URL=

# Admin suite (dev only, from CAPOQA-8)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel -> salon-caporale-v2 -> Settings -> Deployment Protection -> Protection Bypass for Automation.
# Lets tests past the Vercel login on the dev URL.
VERCEL_AUTOMATION_BYPASS_SECRET=
